# Copy to .env and fill in. Never commit .env - it is gitignored.

ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY
ACCESS_CODE=REPLACE_WITH_ACCESS_CODE

PORT=3000

# Where client-chats/ and usage.log get written. Leave blank for local dev (defaults to the
# project root). In production (decisions/004), set this to the mounted persistent-disk path
# so this data survives redeploys and restarts.
DATA_DIR=

# Spend safeguards - decisions/002 and 003. Tune these, don't remove them.
DAILY_REQUEST_CAP=45
SESSION_MESSAGE_CAP=40
SESSION_IDLE_TIMEOUT_MINUTES=15
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_PER_IP=20
MAX_OUTPUT_TOKENS=350

# Handoff email notifications (decisions/006) - optional. Leave any of these blank to disable;
# handoffs still write to disk as before, just without the email step.
# Use a dedicated Gmail account created only for this app, NOT a personal inbox - see decisions/006.
GMAIL_USER=REPLACE_WITH_DEDICATED_GMAIL_ADDRESS
GMAIL_APP_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
OWNER_EMAIL=REPLACE_WITH_OWNER_EMAIL_TO_RECEIVE_HANDOFFS
# Optional second recipient (cc) - e.g. the builder/operator monitoring the test, separate
# from the business owner above. Leave blank if not needed.
NOTIFY_CC_EMAIL=

# Admin dashboard (decisions/006) - a separate secret from ACCESS_CODE. Leave blank to disable
# the dashboard entirely (it will reject all admin codes).
ADMIN_CODE=REPLACE_WITH_ADMIN_CODE
ADMIN_SESSION_IDLE_TIMEOUT_MINUTES=30
ADMIN_RATE_LIMIT_MAX_PER_IP=10
